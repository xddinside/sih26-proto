{
  "name": "@sih/brokers",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "SIH local brokers: Read Broker, Action Broker, and Model Gateway. Requests carry the run lease; every call records a receipt binding Incident, Run, stage, actor, target, and candidate hash.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@sih/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.20.1",
    "typescript": "6.0.3"
  }
}
